+++ b/scripts/build_e11_union.py
@@ -0,0 +1,157 @@
+#!/usr/bin/env python3
+"""E11 — build the masking-aware candidate file (a LOCAL artefact, NOT an upload).
+
+HYPOTHESES.md E11, from D7 (FIELD_AND_METRIC.md §1b): under the staff-confirmed
+mask (DrivenData forum 11516, chrisk-dd 2026-09-16 — known USGS/INGENIOUS
+fault pixels "are masked / excluded from evaluation, so they do not count
+towards penalty terms"), emission ON the supplied catalogue is free, so the
+score-safe file is
+
+    shipped field (88 ch, topk_hard@0.03)      — the catalogue-proxy winner
+  ∪ supplied catalogue label pixels            — the S5-A hedge form (free)
+  ∪ 105-ch surface, top 2% by probability      — the E9 gap-population winner
+
+Two files are written so the contribution of each part is separable:
+
+  A  gems6_hgb88topk03_hedge.tif          = shipped ∪ catalogue
+  B  gems6_hgb88topk03_hedge105topk02.tif = A ∪ 105-ch topk@0.02   (E11)
+
+Both go through raster.check_submission (the same 13-check hard gate
+validate_submission.py runs). Neither is uploaded: that needs the ratified
+account and an explicit human go-ahead (session-log carry-forward), and the
+weekly-submission state of the confirmed account is not knowable from here
+(F5).
+
+Usage:
+    python scripts/build_e11_union.py [--skip-train]   # --skip-train reuses
+    data/evidence/prob_hgb105-e11.f32.npy if present
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+import rasterio
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPO_ROOT / "src"))
+
+from gems import placement, raster  # noqa: E402
+
+LABELS = REPO_ROOT / "data" / "labels.tif"
+SAMPLE = REPO_ROOT / "data" / "sample_submission.tif"
+EV = REPO_ROOT / "data" / "evidence"
+DOWNLOADS = REPO_ROOT / "downloads"
+SHIPPED = DOWNLOADS / "gems6_hgb88-topk03_33cec71ff0.tif"
+TOPK_FRAC = 0.02  # E9 winner placement on the gap population
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--max-neg", type=int, default=400_000)
+    ap.add_argument("--iters", type=int, default=300)
+    ap.add_argument("--skip-train", action="store_true")
+    ap.add_argument("--out-tag", default="e11")
+    args = ap.parse_args()
+
+    t0 = time.time()
+    from build_submission import load_truth, train_model, predict_full
+
+    gt, footprint = load_truth()
+    n_fp = int(footprint.sum())
+    print(f"footprint {n_fp:,} px · catalogue {int((gt & footprint).sum()):,} px",
+          flush=True)
+
+    # --- component 1: the shipped field -------------------------------
+    with rasterio.open(SHIPPED) as src:
+        shipped = np.isfinite(src.read(1)) & (src.read(1) > 0)
+    shipped &= footprint
+    print(f"shipped field: {int(shipped.sum()):,} px", flush=True)
+
+    # --- component 3: the 105-ch surface at topk@0.02 ------------------
+    prob_path = EV / f"prob_hgb105-{args.out_tag}.f32.npy"
+    if args.skip_train and prob_path.exists():
+        prob = np.load(prob_path)
+        print(f"reusing {prob_path}", flush=True)
+    else:
+        model, info = train_model(EV / "features.f32.npy", 105, gt, footprint,
+                                  args.max_neg, iters=args.iters)
+        print(f"trained 105-ch model: {info} [{time.time()-t0:.0f}s]", flush=True)
+        prob = predict_full(EV / "features.f32.npy", model, footprint, 105)
+        EV.mkdir(parents=True, exist_ok=True)
+        np.save(prob_path, prob.astype(np.float32))
+        print(f"saved {prob_path} [{time.time()-t0:.0f}s]", flush=True)
+    gap = placement.topk_mask(prob, footprint, TOPK_FRAC)
+    print(f"105-ch topk@{TOPK_FRAC:g}: {int(gap.sum()):,} px", flush=True)
+    del prob
+
+    # --- unions --------------------------------------------------------
+    base = shipped | (gt & footprint)
+    full = base | gap
+
+    stats: dict = {
+        "footprint_px": n_fp,
+        "catalogue_px": int((gt & footprint).sum()),
+        "shipped_px": int(shipped.sum()),
+        "gap105_px": int(gap.sum()),
+        "shipped_covers_catalogue_px": int((shipped & gt).sum()),
+        "catalogue_added_px": int(((gt & footprint) & ~shipped).sum()),
+        "gap_added_px": int((gap & ~base).sum()),
+        "overlap_gap_in_shipped": int((gap & shipped).sum()),
+        "overlap_gap_in_catalogue": int((gap & gt).sum()),
+        "unionA_px": int(base.sum()),
+        "unionB_px": int(full.sum()),
+        "unionA_pct_of_footprint": 100.0 * float(base.sum()) / n_fp,
+        "unionB_pct_of_footprint": 100.0 * float(full.sum()) / n_fp,
+        "mask_width0_free_px": None,  # filled below (on-catalogue emission)
+        "generated_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "note": ("E11 candidate file(s). NOT submitted: needs the ratified "
+                 "account + human go-ahead. Free-under-mask = pixels exactly "
+                 "on the 60,988 supplied label px (staff mask width is "
+                 "unspecified; corridor pixels are a labelled bet)."),
+    }
+
+    # write + gate both files
+    results = {}
+    for tag, arr in ((f"hgb88topk03_hedge", base),
+                     (f"hgb88topk03_hedge105topk02", full)):
+        arr = np.where(footprint, arr, 0).astype(np.float32)
+        tmp = DOWNLOADS / f"_{tag}.tif"
+        raster.write_submission(arr, tmp, SAMPLE, footprint=footprint)
+        digest = raster.sha256_file(tmp)[:10]
+        final = DOWNLOADS / f"gems6_{tag}_{digest}.tif"
+        tmp.replace(final)
+        rep = raster.check_submission(final)
+        results[tag] = {
+            "file": final.name,
+            "sha256": raster.sha256_file(final),
+            "bytes": final.stat().st_size,
+            "positive_px": int((arr > 0).sum()),
+            "gate_ok": rep.ok,
+            "gate": rep.as_dict(),
+        }
+        print(f"\n{final.name}: {results[tag]['positive_px']:,} px · "
+              f"gate {'PASS' if rep.ok else 'FAIL'}", flush=True)
+        if not rep.ok:
+            print(rep.text())
+            return 1
+
+    stats["files"] = results
+    # free-under-mask accounting for the E11 (B) file
+    bmask = full.astype(bool)
+    stats["mask_width0_free_px"] = int((bmask & gt & footprint).sum())
+    stats["mask_width0_off_mask_px"] = int((bmask & ~(gt & footprint)).sum())
+    (EV / "e11_union_report.json").write_text(
+        json.dumps(stats, indent=2, default=float) + "\n")
+    print(json.dumps({k: v for k, v in stats.items() if k != "files"},
+                     indent=2), flush=True)
+    print(f"[{time.time()-t0:.0f}s] wrote {EV / 'e11_union_report.json'}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
